# Chave pública do CoinGecko (opcional em modo demo).
# Copie este arquivo para `.env` e preencha com a sua chave:
#   cp .env.example .env
#
# A variável precisa do prefixo EXPO_PUBLIC_ para ser exposta ao app.
# IMPORTANTE: os testes automatizados NÃO precisam de chave real nem de rede.
EXPO_PUBLIC_COINGECKO_API_KEY=YOUR_COINGECKO_API_KEY_HERE
